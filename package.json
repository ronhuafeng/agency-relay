{
  "name": "agency-relay",
  "version": "0.1.0",
  "description": "Cloudflare Worker gateway with bound provider credentials and Codex egress support.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ronhuafeng/agency-relay.git"
  },
  "bugs": {
    "url": "https://github.com/ronhuafeng/agency-relay/issues"
  },
  "homepage": "https://github.com/ronhuafeng/agency-relay#readme",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "types:generate": "wrangler types --include-runtime=false --strict-vars=false",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "egress:build": "tsx ./scripts/build-egress.ts",
    "egress:test": "python3 -m unittest discover -s deploy/codex-egress-shim/tests -p 'test_*.py' -v",
    "dev": "pnpm run console:build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "scan:git-artifacts": "tsx ./scripts/scan-git-artifacts.ts",
    "console:build": "tsx ./scripts/build-console-client.ts",
    "design:update": "tsx ./scripts/design-document.ts update",
    "design:check": "tsx ./scripts/design-document.ts check",
    "lint:css": "stylelint \"src/console/**/*.css\"",
    "lint:classes": "eslint src/console/ui --max-warnings 0",
    "test:browser": "NODE_ENV=production playwright test",
    "console:preview": "NODE_ENV=production tsx scripts/console-preview/server.ts",
    "console:snapshot": "NODE_ENV=production tsx scripts/console-preview/snapshot-pages.ts",
    "console:preview:pull": "tsx scripts/console-preview/pull-data.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/parser": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "werift": "0.25.1",
    "wrangler": "^4.152.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.29.1"
    }
  },
  "overrides": {
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "@node-oauth/oauth2-server": "5.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
