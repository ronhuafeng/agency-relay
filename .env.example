# Operator credentials loaded into the shell from the ignored project-root .env.
# Local Worker secrets belong in the ignored .dev.vars instead. Their canonical
# name inventory is wrangler.jsonc `secrets.required`; production values remain
# in Cloudflare Secrets. `pnpm dev` disables Wrangler's .env fallback.

# --- Core operator identity ---
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-worker-deployment-token
# Shared CLI/Worker admin credential. The production Worker copy remains a
# Cloudflare Secret; add a local-only value to .dev.vars when running wrangler dev.
ADMIN_SECRET=replace-with-random-admin-secret

# --- Optional least-privilege operator identities ---
CLOUDFLARE_API_TOKEN_D1_READ=replace-with-d1-read-only-token
# Workers Routes for trustedtunnel.app only.
CLOUDFLARE_API_TOKEN_ROUTES=replace-with-workers-routes-token-optional

# Console login. Production copies are Worker secrets, not committed values.
# The Feishu app redirect URL is https://mini-proxy.uniweaver.com/login/callback.
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
