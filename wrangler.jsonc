{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agency-relay-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough",
    "global_fetch_strictly_public"
  ],
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    "crons": [
      "17 * * * *",
      "17 3 * * *"
    ]
  },
  "vars": {
    "CODEX_OAUTH_TOKEN_URL": "https://auth.openai.com/oauth/token",
    "CODEX_CLIENT_ID": "app_EMoamEEZ73f0CkXaXp7hrann",
    "ADMIN_DASHBOARD_HOST": "console.example.test",
    "CONSOLE_EMAIL_DOMAIN": "example.test",
    "RUNTIME_INSTALLATIONS": "[]",
    "REQUEST_AUDIT_RETENTION_DAYS": "30",
    "RUNTIME_MCP_ORIGIN": ""
  },
  "secrets": {
    "required": [
      "TOKEN_ENCRYPTION_KEY_V1",
      "API_KEY_HASH_PEPPER",
      "ADMIN_SECRET",
      "CODEX_EGRESS_SECRET",
      "FEISHU_APP_ID",
      "FEISHU_APP_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agency-relay-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_AUTHORITY",
        "class_name": "TokenAuthority"
      },
      {
        "name": "CREDENTIAL_EVENTS",
        "class_name": "CredentialEvents"
      },
      {
        "name": "RUNTIME_CREDENTIALS",
        "class_name": "RuntimeCredentials"
      },
      {
        "name": "RUNTIME_OAUTH",
        "class_name": "RuntimeOAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TokenAuthority"
      ]
    },
    {
      "tag": "v2-credential-events",
      "new_sqlite_classes": [
        "CredentialEvents"
      ]
    },
    {
      "tag": "v3-runtime-credentials",
      "new_sqlite_classes": [
        "RuntimeCredentials"
      ]
    },
    {
      "tag": "v4-runtime-oauth",
      "new_sqlite_classes": [
        "RuntimeOAuth"
      ]
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
